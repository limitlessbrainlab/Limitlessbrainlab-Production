{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "installCommand": "npm install && npm install --prefix server",
  "rewrites": [
    {
      "source": "/api/:path((?!send-report-email$|render-performance-pdf$|generate-performance-report$|process-neurosense-report$|ops/backend$).*)",
      "destination": "https://limitlessbrainlab-production-backend.onrender.com/api/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/process-neurosense-report.js": {
      "maxDuration": 800,
      "includeFiles": "{server/assets/**,public/assets/**,server/services/pdfLogo*.js,server/node_modules/pdfjs-dist/cmaps/**,server/node_modules/pdfjs-dist/standard_fonts/**,server/node_modules/@napi-rs/canvas/**,server/node_modules/@napi-rs/canvas-linux-x64-gnu/**}"
    },
    "api/generate-performance-report.js": {
      "maxDuration": 800
    }
  },
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(meditation-thumbs|brain-course)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
